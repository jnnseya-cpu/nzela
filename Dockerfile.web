# NZELA-OS marketing site — landing (/), blog (/blog + posts), partner
# dashboard (/pro), shared PWA kit, sitemap/robots/llms.txt. Assembled by
# frontend/build.mjs (zero npm deps — Node builtins only) and served by nginx.
#
#   docker build -f Dockerfile.web -t nzela-web .
#   docker run -p 8081:80 nzela-web
#
# ── build the static site ─────────────────────────────────────────────────
FROM node:22-slim AS build
WORKDIR /app
COPY frontend ./frontend
# build.mjs derives its own root and writes frontend/dist; site.config.mjs is
# the single source of the WhatsApp number and is swapped in here.
RUN node frontend/build.mjs

# ── serve ─────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine
COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=4s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
