# Keep the build context small + reproducible. node_modules is reinstalled in
# the image; never copy the host's.
node_modules
**/node_modules
.git
.github
# build artifacts + runtime data (dist is rebuilt inside the web image)
frontend/dist
data
backend/server/data
coverage
*.tsbuildinfo
# secrets never enter an image
.env
.env.*
!.env.example
# docs / scratch
docs
*.md
!STATUS.md
