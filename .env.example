# ─────────────────────────────────────────────────────────────────────────
# NZELA-OS — environment configuration
# Copy to `.env` and fill in. `backend/server` reads these (see config.ts).
# Anything left blank degrades SAFELY: outbound WhatsApp falls back to console
# logging, analytics sinks stay inert, unsigned webhooks are accepted. The
# startup log prints exactly which required keys are still missing.
# See docs/EXTERNAL_API_KEYS.md for how to obtain each one.
# ─────────────────────────────────────────────────────────────────────────

# ── Ports & storage ──────────────────────────────────────────────────────
GATEWAY_PORT=8080
LIPA_PORT=8090
# Directory for the durable file-backed stores (sessions, tokens, open orders,
# replay index, TK-ref sequence). Must be writable and persisted across
# restarts. A single instance gets real durability here with no database.
DATA_DIR=./data

# At-rest encryption for the token / PII / financial stores (AES-256-GCM).
# 32-byte key, base64 (recommended) or 64 hex chars. Generate with:
#   openssl rand -base64 32
# Unset = plaintext on disk (OK for local dev; set this in production).
# Keep it stable and backed up — a lost/changed key makes existing encrypted
# stores unreadable (decryption fails loudly rather than wiping data).
DATA_ENCRYPTION_KEY=

# ── WhatsApp Cloud API (Meta) — the front door (CRITICAL) ────────────────
# Without these, no customer can be messaged (sender logs to console instead).
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# A string you choose; must match what you enter in the Meta webhook setup.
WA_VERIFY_TOKEN=
# Meta App Secret — verifies X-Hub-Signature-256 on every inbound message.
# If unset, inbound signatures are NOT checked (dev only).
WA_APP_SECRET=
# Optional; defaults to a current Graph API version in code.
WA_GRAPH_VERSION=v21.0

# ── StackFood (cd.tunakula.com) — catalog + orders + wallet ──────────────
STACKFOOD_BASE_URL=https://cd.tunakula.com/api/v1
# Zone header for catalog endpoints — JSON array or CSV, e.g. [1] or 1,2
STACKFOOD_ZONE_IDS=[1]
# Shared secret for the StackFood OrderObserver webhook HMAC (X-NZELA-Signature).
STACKFOOD_WEBHOOK_SECRET=
# Admin bearer token — only needed to credit wallets (referral rewards).
STACKFOOD_ADMIN_TOKEN=

# ── SMS Ledger Bridge (Lipa Box) ─────────────────────────────────────────
# Shared secret the Android SMS-forwarder sends as X-Lipa-Token. Self-chosen.
LIPA_INGEST_TOKEN=

# ── Delivery + merchant payout numbers (printed in pay instructions) ─────
# Pilot delivery zone: 1 (Bandal core), 2, or 3.
DELIVERY_ZONE=1
# At least one merchant mobile-money number is required to instruct payment.
MERCHANT_MPESA=
MERCHANT_ORANGE=
MERCHANT_AIRTEL=
MERCHANT_AFRICELL=

# ── Analytics & marketing (optional; sinks inert until set) ──────────────
# Meta Pixel + Conversions API
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
# Google Analytics 4 (Measurement Protocol)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
